# api_platform 环境配置模板：复制为 .env 并按本机情况修改；.env 不入库
# 生产环境必须：HTTPS + SECURE_COOKIES=true，并将 ALLOWED_ORIGINS 改为正式前端地址

APP_DEBUG=false

# 会话
SESSION_COOKIE_NAME=sd_session
SESSION_TTL_MINUTES=720
SECURE_COOKIES=false
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 登录失败限速：300 秒内失败 5 次后返回 429
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300

# CSRF 令牌派生密钥（H01）：C 的 sessions 表不保存 csrf_token，D 用本密钥对
# 会话摘要做 HMAC-SHA256 派生 CSRF 令牌。生产环境必须显式设置随机值；
# 留空时进程启动会生成一次性随机值并告警（重启后既有会话 CSRF 失效）。
CSRF_SECRET=change-me-to-a-random-48-byte-urlsafe-string

# 数据库连接（由 C 的 data_foundation 使用：迁移与后端读同一配置）
# 版本约定：MySQL 8.4.11 LTS（C/D/E 统一）
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/tourism_flow

# 作业库后端（C 0.2.0a2 接入后新增）
# c_store（默认）：知识任务落在 C 的 jobs / knowledge 表，D 是唯一消费者
# sqlite        ：退回 D 的 SQLite 桥，仅本地回环与测试用
D_JOB_STORE_BACKEND=c_store

# E 的 intelligent_analysis 配置（E 不负责迁移；变量名以本模板为准，E 侧读取同一 .env）
RAG_INDEX_PATH=./data/rag_index.json        # 快照留档/路径模式回退；正式问答走 C loader
OPENVINO_DEVICE=CPU                         # CPU | GPU | NPU | AUTO
VIDEO_TMP_DIR=./data/video_tmp              # 视频处理临时目录（磁盘，不占内存）
COUNTS_STORAGE_PATH=./data/counts           # 计数结果存储路径

# P2PNet 点计数模型包（E 0.6.0：录像计数口径固定 P2PNet，DM-Count 已废弃）
# 目录须含 SHTechA.pth、models/、util/（SHA256 清单由 E 的 from_team_bundle 校验）
# 未登记时：26 号返回 422 unsupported，video_analysis 作业按「P2PNet 模型包未登记」诚实失败，不伪造
P2PNET_BUNDLE_DIR=./data/p2pnet_bundle
# OpenAI-compatible LLM; fill secrets only in .env, then restart the API.
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
