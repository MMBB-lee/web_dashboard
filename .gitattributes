# Evidence and pinned model sources are verified by SHA256. Preserve their bytes
# across Windows/Linux checkouts rather than applying automatic line endings.
data_foundation/real_data/** -text
**/model_bundle/** -text
**/fixtures/** -text
**/acceptance/** -text

# Keep browser-playable recordings in Git LFS (one exceeds GitHub's blob limit).
videos/*.mp4 filter=lfs diff=lfs merge=lfs -text

# Preserve SQL escapes and archived runtime assets exactly across platforms.
server-migration/*.sql -text
server-migration/*.tar.gz -text
